#!/bin/bash
#
# Erinnerungen per systemd-Timer: Port von Omarchys bin/omarchy-reminder
# (basecamp/omarchy, MIT) für DMS.
#
#   dms-reminder <wann> [notiz]         wann: 25 | 3h30m4s | 1h30 | 45s | 14:30
#   dms-reminder --seconds N [notiz]    (so ruft das Widget auf)
#   dms-reminder --silent …             ohne Ton beim Auslösen
#   dms-reminder --unit h|m|s …         Einheit einer Zahl ohne Einheit (Standard m)
#   dms-reminder show [--json]
#   dms-reminder cancel <unit>
#   dms-reminder clear
#
# Jede Erinnerung ist ein transienter User-Timer "dms-reminder-<zeit>-<pid>".
# Er überlebt einen Neustart der Shell, nicht aber einen des Rechners -- wie
# bei Omarchy. Die Nachricht liegt daneben in $XDG_RUNTIME_DIR, die
# Fälligkeit liest `show` aus systemctl list-timers.

set -euo pipefail

PREFIX="dms-reminder"
REMINDER_DIR="${XDG_RUNTIME_DIR:-/tmp}/dms-reminders"
SOUND="/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"

# Wie describeDuration in Model.js: "3 h 30 min 4 s", "15 min", "45 s".
format_remaining() {
  local seconds=$1
  local hours=$((seconds / 3600))
  local minutes=$(((seconds % 3600) / 60))
  local remainder=$((seconds % 60))
  local parts=()

  ((hours > 0)) && parts+=("${hours} h")
  ((minutes > 0)) && parts+=("${minutes} min")
  ((remainder > 0 || ${#parts[@]} == 0)) && parts+=("${remainder} s")
  echo "${parts[*]}"
}

# Dieselben Formate wie parseDuration in Model.js, für den Aufruf von Hand.
# $2: Einheit einer Zahl ohne Einheit (h|m|s, Standard m).
parse_when() {
  local spec=${1// /}
  spec=${spec,,}
  local bare=${2:-m}
  local h m now target total=0 last=-1 idx num unit
  local -A secs=([h]=3600 [m]=60 [s]=1)
  local order=(h m s)

  if [[ $spec =~ ^([0-9]{1,2})[:.]([0-9]{2})$ ]]; then
    h=$((10#${BASH_REMATCH[1]}))
    m=$((10#${BASH_REMATCH[2]}))
    ((h < 24 && m < 60)) || return 1
    now=$(date +%s)
    target=$(date -d "$(printf '%02d:%02d' "$h" "$m")" +%s)
    ((target <= now)) && target=$(date -d "tomorrow $(printf '%02d:%02d' "$h" "$m")" +%s)
    echo $((target - now))
    return 0
  fi

  if [[ $spec =~ ^[0-9]+$ ]]; then
    [[ -n ${secs[$bare]:-} ]] || return 1
    total=$((10#$spec * ${secs[$bare]}))
    ((total > 0)) || return 1
    echo "$total"
    return 0
  fi

  # Folge aus Zahl+Einheit, absteigend; eine Zahl ohne Einheit am Ende zählt
  # in der nächstkleineren Einheit ("1h30" = 1 h 30 min).
  [[ -n $spec ]] || return 1
  while [[ -n $spec ]]; do
    [[ $spec =~ ^([0-9]+)(min|h|m|s)?(.*)$ ]] || return 1
    num=$((10#${BASH_REMATCH[1]}))
    unit=${BASH_REMATCH[2]}
    spec=${BASH_REMATCH[3]}
    [[ $unit == min ]] && unit=m
    if [[ -n $unit ]]; then
      case $unit in h) idx=0 ;; m) idx=1 ;; s) idx=2 ;; esac
    else
      [[ -z $spec ]] && ((last >= 0 && last < 2)) || return 1
      idx=$((last + 1))
    fi
    ((idx > last)) || return 1
    total=$((total + num * ${secs[${order[$idx]}]}))
    last=$idx
  done
  ((total > 0)) || return 1
  echo "$total"
}

active_reminder_timers() {
  local now=${1:-$(date +%s)}
  local timer next

  while IFS=$'\t' read -r timer next; do
    [[ -z $timer || -z $next ]] && continue
    next=$((next / 1000000))
    ((next <= now)) && continue
    printf "%s\t%s\n" "$timer" "$next"
  done < <(systemctl --user list-timers --all --output=json "$PREFIX-*.timer" 2>/dev/null | jq -r 'sort_by(.next) | .[] | [.unit, .next] | @tsv')
}

refresh_widget() {
  dms ipc call reminder refresh >/dev/null 2>&1 || true
}

show_json() {
  local now=$(date +%s)
  local timer next unit message items=()

  while IFS=$'\t' read -r timer next; do
    unit=${timer%.timer}
    message=""
    [[ -f $REMINDER_DIR/$unit.message ]] && message=$(<"$REMINDER_DIR/$unit.message")
    items+=("$(jq -cn --arg unit "$unit" --arg message "$message" --argjson at "$next" \
      --arg atTime "$(date -d "@$next" +%-H:%M)" '{unit:$unit,message:$message,at:$at,atTime:$atTime}')")
  done < <(active_reminder_timers "$now")

  printf '%s\n' "${items[@]}" | jq -cs --argjson now "$now" 'map(select(. != null)) | {now:$now,count:length,reminders:.}'
}

show_text() {
  local now=$(date +%s)
  local timer next unit message body=""

  while IFS=$'\t' read -r timer next; do
    unit=${timer%.timer}
    message=""
    [[ -f $REMINDER_DIR/$unit.message ]] && message=$(<"$REMINDER_DIR/$unit.message")
    [[ -n $message ]] || message="Timer"
    body+="$message in $(format_remaining $((next - now))) ($(date -d "@$next" +%-H:%M))"$'\n'
  done < <(active_reminder_timers "$now")

  if [[ -z $body ]]; then
    echo "Kein Timer"
  else
    printf '%s' "$body"
  fi
}

cancel_one() {
  local unit=${1%.timer}
  [[ $unit == "$PREFIX-"* ]] || { echo "Keine Erinnerung: $unit" >&2; exit 1; }
  systemctl --user stop "$unit.timer" 2>/dev/null || true
  rm -f "$REMINDER_DIR/$unit.message"
  refresh_widget
}

clear_all() {
  local units
  units=$(systemctl --user list-timers --all --output=json "$PREFIX-*.timer" 2>/dev/null | jq -r '.[].unit')
  [[ -n $units ]] && xargs -r systemctl --user stop <<<"$units" || true
  rm -f "$REMINDER_DIR/$PREFIX"-*.message 2>/dev/null || true
  refresh_widget
}

usage() {
  echo "Aufruf: dms-reminder [--silent] [--unit h|m|s] <wann> [notiz]   (wann: 25 | 3h30m4s | 1h30 | 45s | 14:30)"
  echo "        dms-reminder [--silent] --seconds N [notiz]"
  echo "        dms-reminder show [--json]"
  echo "        dms-reminder cancel <unit>"
  echo "        dms-reminder clear"
}

case ${1:-} in
show | list)
  case ${2:-} in
  -j | --json) show_json ;;
  "") show_text ;;
  *) usage; exit 1 ;;
  esac
  exit 0
  ;;
cancel)
  [[ -n ${2:-} ]] || { usage; exit 1; }
  cancel_one "$2"
  exit 0
  ;;
clear)
  clear_all
  exit 0
  ;;
-h | --help)
  usage
  exit 0
  ;;
esac

sound=1
unit_bare=m
while [[ ${1:-} == --silent || ${1:-} == --unit ]]; do
  case $1 in
  --silent) sound=0; shift ;;
  --unit) unit_bare=${2:-m}; shift 2 || true ;;
  esac
done

if [[ ${1:-} == --seconds ]]; then
  seconds=${2:-}
  shift 2 || true
else
  seconds=$(parse_when "${1:-}" "$unit_bare") || seconds=""
  shift || true
fi

if [[ ! $seconds =~ ^[0-9]+$ ]] || ((seconds == 0)); then
  usage
  exit 1
fi

# Ohne Notiz ist es ein Timer ohne Namen: Titel "Timer abgelaufen", die
# Dauer steht im Text. Mit Notiz steht die Notiz im Titel.
message="$*"
if [[ -n $message ]]; then
  title=$message
  body="Timer $(format_remaining "$seconds")"
else
  title="Timer abgelaufen"
  body="$(format_remaining "$seconds")"
fi

set_at=$(date +%s)
unit="$PREFIX-$set_at-$$"
message_file="$REMINDER_DIR/$unit.message"
mkdir -p "$REMINDER_DIR"
printf "%s" "$message" >"$message_file"   # leer bei Timer ohne Notiz

# Was beim Auslösen läuft: Meldung, Ton, aufräumen, Widget anstoßen. Alles mit
# `|| true`, damit ein fehlender Player nicht die Meldung verschluckt.
#   -u critical    das Popup bleibt stehen, bis man es wegklickt
#   --transient    danach ist es ganz weg: DMS legt transiente Meldungen weder
#                  ins Benachrichtigungszentrum noch in den Verlauf
#                  (NotificationService.qml: shouldKeepInCenter = !transient)
#   suppress-sound kein zweiter Ton von DMS, den Weckerton spielt das Skript
systemd-run --user --quiet --collect --on-active="${seconds}s" --unit="$unit" \
  bash -c '
    notify-send -u critical --transient -h boolean:suppress-sound:true \
      -a "Timer" -i alarm-symbolic "$1" "$5" || true
    if [[ $3 == 1 ]]; then
      canberra-gtk-play -i alarm-clock-elapsed 2>/dev/null || pw-play "$4" 2>/dev/null || true
    fi
    rm -f "$2"
    dms ipc call reminder refresh >/dev/null 2>&1 || true
  ' bash "$title" "$message_file" "$sound" "$SOUND" "$body"

refresh_widget
echo "$unit $(date -d "@$((set_at + seconds))" +%-H:%M)"
