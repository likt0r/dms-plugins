#!/bin/sh
# Proton-Verbindung nach einem unerwarteten Abbruch wiederherstellen.
#
#   proton-recover [protonvpn-connect-Argumente …]   neu verbinden
#   proton-recover --release                          Sperre bewusst aufheben
#   proton-recover --check                            Exit 0, wenn Sperre steht
#
# Warum es das braucht: `protonvpn connect` hinterlässt Sperr-Verbindungen in
# NetworkManager. Mit Kill Switch "standard" ist das "pvpn-killswitch" (ein
# Dummy-Gerät als Standardroute, alles außer tun0 läuft ins Leere), mit Kill
# Switch "off" nur der IPv6-Leckschutz "pvpn-killswitch-ipv6" (DNS ::1 mit
# dns-priority -1400, damit schluckt er jede Namensauflösung). Abgebaut werden
# beide nur vom Proton-Prozess, der das Trennen mitbekommt
# (proton/vpn/connection/states.py, Disconnected). Die CLI ist nach dem
# Verbinden aber beendet. Stirbt der Tunnel ohne sie -- typisch nach dem
# Ruhezustand: OpenVPN läuft in den ping-restart und beendet sich --, bleibt
# die Sperre stehen.
#
# Ablauf: steht keine Sperre (sauber getrennt), passiert nichts. Sonst auf eine
# echte Standardroute warten und neu verbinden. Klappt das nicht, bleibt die
# Sperre bewusst stehen -- lieber offline als ungetarnt. Aufheben nur mit
# --release, also auf ausdrücklichen Wunsch.
#
# Exit: 0 nichts zu tun, neu verbunden oder freigegeben; 1 Neuverbinden
# fehlgeschlagen bzw. Sperre nicht aufgehoben, Netz bleibt gesperrt; 2 läuft
# schon (anderer Schirm). Bei 1 steht der Grund als eine Zeile auf stdout --
# das Widget setzt ihn in seine Benachrichtigung. Jeden gescheiterten Versuch
# mit voller Ausgabe gibt es im Journal: journalctl -t vpnhub-proton-recover.

LOCKS="pvpn-killswitch pvpn-killswitch-ipv6 pvpn-routed-killswitch"

locked() {
    nmcli -t -f NAME connection show --active | grep -q '^pvpn-.*killswitch'
}

# Ins Journal und auf stderr; Zeilenumbrüche flach, sonst zerfällt die
# Ausgabe der CLI im Journal in Einzelteile ohne Zusammenhang.
log() {
    msg=$(printf '%s' "$*" | tr '\n' ' ')
    logger -t vpnhub-proton-recover -p user.err -- "$msg" 2>/dev/null
    printf '%s\n' "$msg" >&2
}

# Der kurze Grund aus einer CLI-Ausgabe: die letzte "Error:"-Zeile, sonst die
# letzte nicht leere.
reason() {
    r=$(printf '%s\n' "$1" | sed -n 's/^[[:space:]]*Error:[[:space:]]*//p' | tail -n 1)
    [ -n "$r" ] || r=$(printf '%s\n' "$1" | grep -v '^[[:space:]]*$' | tail -n 1 | sed 's/^[[:space:]]*//')
    printf '%s' "$r"
}

if [ "$1" = "--check" ]; then
    locked
    exit
fi

if [ "$1" = "--release" ]; then
    # Nur löschen, was es gibt: ein "unknown connection" für die übrigen
    # Namen wäre sonst der vermeintliche Grund.
    why=""
    for c in $LOCKS; do
        nmcli -t -f NAME connection show | grep -qx "$c" || continue
        if ! out=$(nmcli connection delete "$c" 2>&1); then
            log "nmcli connection delete $c: $out"
            why=$(reason "$out")
        fi
    done
    if locked; then
        left=$(nmcli -t -f NAME connection show --active | grep '^pvpn-.*killswitch' | tr '\n' ' ')
        [ -n "$why" ] || why="Sperre steht noch (${left% })"
        log "release: Sperre steht noch (${left% }): $why"
        echo "$why"
        exit 1
    fi
    exit 0
fi

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/vpnhub-proton-recover.lock"
flock -n 9 || exit 2

locked || exit 0

# Echte Standardroute: nicht über die Dummy-Geräte von Proton, nicht über tun.
online() {
    ip -4 route show default | grep -v -q -e pvpn -e ipv6leak -e 'dev tun' -e '^$'
}

i=0
while ! online && [ $i -lt 60 ]; do
    sleep 1
    i=$((i + 1))
done

if online; then
    why=""
    for n in 1 2 3; do
        out=$(protonvpn connect "$@" 2>&1)
        rc=$?
        [ $rc -eq 0 ] && exit 0
        why=$(reason "$out")
        [ -n "$why" ] || why="protonvpn connect endete mit Code $rc"
        log "Versuch $n/3: protonvpn connect $* → Exit $rc: $out"
        [ $n -lt 3 ] && sleep 5
    done
else
    why="kein Netz (nach 60 s keine Standardroute)"
    log "$why"
fi

echo "$why"
exit 1
